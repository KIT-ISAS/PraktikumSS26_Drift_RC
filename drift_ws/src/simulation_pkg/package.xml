<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>simulation_pkg</name>
  <version>0.0.0</version>
  <description>ROS2 wrapper that runs a drift_core model and publishes the simulated canonical car state (/car/pose, /car/odom, world-&gt;base_link TF)</description>
  <maintainer email="julian-bihl@t-online.de">Julian Bihl</maintainer>
  <license>Apache License 2.0</license>

  <depend>shared_pkg</depend>
  <depend>shared_interfaces</depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>car_localization_pkg</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
