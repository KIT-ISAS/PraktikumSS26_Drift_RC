<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>car_localization_pkg</name>
  <version>0.0.0</version>
  <description>
    Source-agnostic car localization: turns a tracking source's tracker pose into
    the canonical car frames/state (CoG, ISO 8855) — static mount transforms, the
    central state node (/car/pose, /car/odom, /car/imu), and car visualization.
  </description>
  <maintainer email="root@todo.todo">root</maintainer>
  <license>TODO: License declaration</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>visualization_msgs</exec_depend>
  <exec_depend>shared_pkg</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <!-- NOTE: car_localization.launch.py includes libsurvive_pkg/steamvr_pkg launch
       files, but we deliberately do NOT exec_depend on them: those packages
       already depend on this one (their launches start world_anchor_node), so
       declaring it back forms a colcon dependency cycle. The include uses
       FindPackageShare, which resolves lazily only when that source is actually
       started, so the missing metadata is harmless (start_tracking_source:=false
       never resolves it). -->


  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
