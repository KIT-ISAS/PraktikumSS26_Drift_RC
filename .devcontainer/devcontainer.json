{
    "name": "ROS 2 Drift RC",
    "dockerComposeFile": "docker-compose.yaml",
    "service": "ros2",
    "workspaceFolder": "/root/repo/",
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-python.python",
                "charliermarsh.ruff",
                "Ranch-Hand-Robotics.rde-pack",
                "ms-python.vscode-pylance"
            ],
            "settings": {
                "python.defaultInterpreterPath": "/usr/bin/python3",
                "[python]": {
                    "editor.defaultFormatter": "charliermarsh.ruff",
                    "editor.formatOnSave": true
                }
            }
        }
    },
    "postCreateCommand": "mkdir -p ~/.ssh && echo 'Host github-gmail\\n  HostName github.com\\n  User git' > ~/.ssh/config",
    "remoteUser": "root"
}